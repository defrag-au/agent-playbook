{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "browser_shot_scenario",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "run"
          },
          {
            "type": "SYMBOL",
            "name": "peer"
          },
          {
            "type": "SYMBOL",
            "name": "wait"
          },
          {
            "type": "SYMBOL",
            "name": "eval"
          },
          {
            "type": "SYMBOL",
            "name": "key"
          },
          {
            "type": "SYMBOL",
            "name": "pointer"
          },
          {
            "type": "SYMBOL",
            "name": "capture"
          },
          {
            "type": "SYMBOL",
            "name": "assert"
          },
          {
            "type": "SYMBOL",
            "name": "network"
          },
          {
            "type": "SYMBOL",
            "name": "_blank"
          }
        ]
      }
    },
    "_blank": {
      "type": "SYMBOL",
      "name": "_newline"
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_line_end": {
      "type": "SYMBOL",
      "name": "_newline"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#.*"
      }
    },
    "run": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "run"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "field"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "peer": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "peer"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "flag"
              },
              {
                "type": "SYMBOL",
                "name": "field"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "wait": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "wait"
        },
        {
          "type": "SYMBOL",
          "name": "peer_list"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "field"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "eval": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "eval"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "flag"
              },
              {
                "type": "SYMBOL",
                "name": "field"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "key": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "key"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "SYMBOL",
          "name": "code"
        },
        {
          "type": "SYMBOL",
          "name": "key_state"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "field"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "pointer": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "pointer"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "SYMBOL",
          "name": "pointer_kind"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "field"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "capture": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "capture"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "field"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "assert": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "assert"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "field"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "network": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "network"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "field"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "field": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "key_name"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        }
      ]
    },
    "key_name": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "bare_value"
        }
      ]
    },
    "string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "\"(\\\\.|[^\"\\\\])*\""
        },
        {
          "type": "PATTERN",
          "value": "'(\\\\.|[^'\\\\])*'"
        }
      ]
    },
    "bare_value": {
      "type": "PATTERN",
      "value": "[^\\s\"'=#]+"
    },
    "name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "bare_name"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        }
      ]
    },
    "bare_name": {
      "type": "PATTERN",
      "value": "[^\\s,\"'=#]+"
    },
    "expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "bare_expression"
        }
      ]
    },
    "bare_expression": {
      "type": "PATTERN",
      "value": "[^\\s=#]+"
    },
    "peer_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "name"
              }
            ]
          }
        }
      ]
    },
    "code": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9]+"
    },
    "flag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "touch"
        },
        {
          "type": "STRING",
          "value": "headed"
        },
        {
          "type": "STRING",
          "value": "await"
        }
      ]
    },
    "key_state": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "down"
        },
        {
          "type": "STRING",
          "value": "up"
        }
      ]
    },
    "pointer_kind": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "click"
        },
        {
          "type": "STRING",
          "value": "hover"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "SYMBOL",
      "name": "comment"
    },
    {
      "type": "PATTERN",
      "value": "[ \\t]+"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}